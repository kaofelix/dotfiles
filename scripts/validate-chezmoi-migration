#!/usr/bin/env python3
"""Compare the frozen Stow baseline with the frozen chezmoi migration.

The real HOME is never read or written. The semantic manifests dereference
Stow's implementation symlinks so contents and modes can be compared with
chezmoi's regular-file target state. Physical manifests retain every file type
and normalized symlink target for auditability.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
BASELINE_FILE = ROOT / "migration" / "stow-baseline-revision"
CHEZMOI_REVISION_FILE = ROOT / "migration" / "chezmoi-migration-revision"
PACKAGE_FILE = ROOT / "migration" / "packages.txt"
EXPECTED_DIFFERENCES_FILE = ROOT / "migration" / "expected-differences.json"


def run(*args: str, cwd: Path | None = None, capture: bool = False) -> str:
    result = subprocess.run(
        args,
        cwd=cwd,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    return result.stdout if capture else ""


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def kind(mode: int) -> str:
    if stat.S_ISREG(mode):
        return "file"
    if stat.S_ISDIR(mode):
        return "directory"
    if stat.S_ISLNK(mode):
        return "symlink"
    return "other"


def physical_manifest(root: Path, baseline_source: Path | None = None) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for current, dirs, files in os.walk(root, followlinks=False):
        current_path = Path(current)
        # os.walk puts symlinked directories in dirs; record them but do not enter.
        names = sorted(dirs + files)
        for name in names:
            path = current_path / name
            relative = path.relative_to(root).as_posix()
            info = path.lstat()
            row: dict[str, Any] = {
                "path": relative,
                "type": kind(info.st_mode),
                "mode": f"{stat.S_IMODE(info.st_mode):04o}",
            }
            if stat.S_ISLNK(info.st_mode):
                target = os.readlink(path)
                if baseline_source is not None:
                    resolved = (path.parent / target).resolve()
                    try:
                        source_relative = resolved.relative_to(baseline_source.resolve())
                    except ValueError:
                        pass
                    else:
                        target = f"<BASELINE_SOURCE>/{source_relative.as_posix()}"
                row["target"] = target
                if path.is_dir() and name in dirs:
                    dirs.remove(name)
            elif stat.S_ISREG(info.st_mode):
                row["size"] = info.st_size
                row["sha256"] = sha256(path)
            rows.append(row)
    return sorted(rows, key=lambda row: row["path"])


def baseline_entries(source: Path, packages: list[str]) -> dict[str, Path]:
    entries: dict[str, Path] = {}
    for package in packages:
        package_dir = source / package
        if not package_dir.is_dir():
            raise RuntimeError(f"baseline package does not exist: {package}")
        for current, dirs, files in os.walk(package_dir):
            dirs[:] = sorted(name for name in dirs if name != "node_modules")
            for name in sorted(files):
                path = Path(current) / name
                relative = path.relative_to(package_dir).as_posix()
                previous = entries.setdefault(relative, path)
                if previous != path:
                    raise RuntimeError(
                        f"packages map more than one source to {relative}: "
                        f"{previous} and {path}"
                    )
    return entries


def semantic_manifest(home: Path, entries: dict[str, Path]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for relative, source in sorted(entries.items()):
        target = home / relative
        if not target.exists():
            raise RuntimeError(f"installed target is missing: {relative}")
        info = target.stat()  # Deliberately dereference Stow's symlinks.
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"installed target is not a regular-file value: {relative}")
        source_info = source.stat()
        rows.append(
            {
                "path": relative,
                "mode": f"{stat.S_IMODE(info.st_mode):04o}",
                "size": info.st_size,
                "sha256": sha256(target),
                "source_mode": f"{stat.S_IMODE(source_info.st_mode):04o}",
            }
        )
    return rows


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def compare_semantic(
    baseline: list[dict[str, Any]], chezmoi: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    mismatches: list[dict[str, Any]] = []
    baseline_by_path = {row["path"]: row for row in baseline}
    chezmoi_by_path = {row["path"]: row for row in chezmoi}
    for path in sorted(baseline_by_path.keys() | chezmoi_by_path.keys()):
        old = baseline_by_path.get(path)
        new = chezmoi_by_path.get(path)
        if old != new:
            mismatches.append({"path": path, "stow": old, "chezmoi": new})
    return mismatches


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "packages",
        nargs="*",
        help="Stow packages to compare (default: all packages in migration/packages.txt)",
    )
    parser.add_argument("--artifacts-dir", type=Path)
    args = parser.parse_args()

    required = ["git", "stow", "chezmoi"]
    missing = [command for command in required if shutil.which(command) is None]
    if missing:
        parser.error(f"missing required commands: {', '.join(missing)}")

    all_packages = [
        line.strip()
        for line in PACKAGE_FILE.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]
    packages = args.packages or all_packages
    unknown = sorted(set(packages) - set(all_packages))
    if unknown:
        parser.error(f"unknown packages: {', '.join(unknown)}")

    baseline_revision = BASELINE_FILE.read_text().strip()
    chezmoi_revision = CHEZMOI_REVISION_FILE.read_text().strip()
    # Prove that both frozen objects are present before creating fixtures.
    run("git", "cat-file", "-e", f"{baseline_revision}^{{commit}}", cwd=ROOT)
    run("git", "cat-file", "-e", f"{chezmoi_revision}^{{commit}}", cwd=ROOT)

    with tempfile.TemporaryDirectory(prefix="dotfiles-chezmoi-validation-") as raw_tmp:
        tmp = Path(raw_tmp)
        baseline_source = tmp / "baseline-source"
        chezmoi_source = tmp / "chezmoi-source"
        baseline_home = tmp / "stow-home"
        chezmoi_home = tmp / "chezmoi-home"
        baseline_source.mkdir()
        chezmoi_source.mkdir()
        baseline_home.mkdir()
        chezmoi_home.mkdir()

        archive = subprocess.Popen(
            ["git", "archive", baseline_revision], cwd=ROOT, stdout=subprocess.PIPE
        )
        assert archive.stdout is not None
        extract = subprocess.run(
            ["tar", "-xf", "-", "-C", str(baseline_source)],
            stdin=archive.stdout,
            check=True,
        )
        archive.stdout.close()
        if archive.wait() != 0 or extract.returncode != 0:
            raise RuntimeError("could not extract frozen Stow baseline")

        archive = subprocess.Popen(
            ["git", "archive", chezmoi_revision], cwd=ROOT, stdout=subprocess.PIPE
        )
        assert archive.stdout is not None
        extract = subprocess.run(
            ["tar", "-xf", "-", "-C", str(chezmoi_source)],
            stdin=archive.stdout,
            check=True,
        )
        archive.stdout.close()
        if archive.wait() != 0 or extract.returncode != 0:
            raise RuntimeError("could not extract frozen chezmoi migration")

        for package in packages:
            run(
                "stow",
                "--restow",
                package,
                f"--target={baseline_home}",
                cwd=baseline_source,
            )

        entries = baseline_entries(baseline_source, packages)
        baseline_semantic = semantic_manifest(baseline_home, entries)
        baseline_physical = physical_manifest(baseline_home, baseline_source)

        config = tmp / "chezmoi.toml"
        cache = tmp / "cache"
        state = tmp / "state.db"
        common = [
            "chezmoi",
            "--source",
            str(chezmoi_source),
            "--destination",
            str(chezmoi_home),
            "--config",
            str(config),
            "--cache",
            str(cache),
            "--persistent-state",
            str(state),
            "--no-tty",
            "--no-pager",
        ]
        # Externals are tested separately: the parity comparison covers only the
        # files that Stow used to install and must never perform network access.
        run(*common, "apply", "--exclude=externals,scripts")
        first_physical = physical_manifest(chezmoi_home)
        run(*common, "apply", "--exclude=externals,scripts")
        second_physical = physical_manifest(chezmoi_home)
        if first_physical != second_physical:
            raise RuntimeError("chezmoi apply is not idempotent")
        run(*common, "verify", "--exclude=externals,scripts")
        if run(*common, "diff", "--exclude=externals,scripts", capture=True):
            raise RuntimeError("chezmoi diff is not empty after apply")

        managed_output = run(
            *common,
            "managed",
            "--include=files,symlinks",
            "--path-style=relative",
            capture=True,
        )
        managed = {line for line in managed_output.splitlines() if line}
        expected = set(entries)
        if managed != expected:
            raise RuntimeError(
                "managed leaf set differs from selected baseline packages: "
                f"missing={sorted(expected - managed)}, extra={sorted(managed - expected)}"
            )

        chezmoi_semantic = semantic_manifest(chezmoi_home, entries)
        chezmoi_physical = second_physical
        mismatches = compare_semantic(baseline_semantic, chezmoi_semantic)

        difference_rules = json.loads(EXPECTED_DIFFERENCES_FILE.read_text())
        expected_differences: list[dict[str, Any]] = []
        unexplained_differences: list[dict[str, Any]] = []
        mismatched_paths: set[str] = set()
        for mismatch in mismatches:
            path = mismatch["path"]
            mismatched_paths.add(path)
            rule = difference_rules.get(path)
            if rule is None or mismatch["stow"] is None or mismatch["chezmoi"] is None:
                unexplained_differences.append(mismatch)
                continue
            changed_fields = sorted(
                key
                for key in mismatch["stow"].keys() | mismatch["chezmoi"].keys()
                if mismatch["stow"].get(key) != mismatch["chezmoi"].get(key)
            )
            if set(changed_fields) <= set(rule["fields"]):
                expected_differences.append(
                    mismatch | {"changed_fields": changed_fields, "reason": rule["reason"]}
                )
            else:
                unexplained_differences.append(
                    mismatch
                    | {
                        "changed_fields": changed_fields,
                        "allowed_fields": rule["fields"],
                    }
                )
        stale_rules = sorted(
            path
            for path in difference_rules
            if path in expected and path not in mismatched_paths
        )
        if stale_rules:
            raise RuntimeError(f"expected-difference rules no longer differ: {stale_rules}")

        baseline_links = [
            row for row in baseline_physical if row["type"] == "symlink"
        ]
        chezmoi_links = [row for row in chezmoi_physical if row["type"] == "symlink"]
        unexpected_links = [
            row for row in baseline_links if "<BASELINE_SOURCE>" not in row["target"]
        ]
        if unexpected_links:
            raise RuntimeError(f"Stow created unexpected symlinks: {unexpected_links}")
        if chezmoi_links:
            raise RuntimeError(f"chezmoi unexpectedly created symlinks: {chezmoi_links}")

        summary = {
            "baseline_revision": baseline_revision,
            "chezmoi_revision": chezmoi_revision,
            "packages": packages,
            "managed_leaf_count": len(expected),
            "semantic_difference_count": len(mismatches),
            "expected_difference_count": len(expected_differences),
            "unexplained_difference_count": len(unexplained_differences),
            "expected_differences": expected_differences,
            "idempotent_apply": True,
            "chezmoi_verify": "passed",
            "chezmoi_diff_after_apply": "empty",
            "physical_difference_policy": {
                "stow": "symlinks into the frozen source tree",
                "chezmoi": "ordinary directories and regular files",
                "reason": "intentional adoption of chezmoi's default portable file mode",
                "stow_symlink_count": len(baseline_links),
                "chezmoi_symlink_count": len(chezmoi_links),
            },
            "result": "passed" if not unexplained_differences else "failed",
        }

        if args.artifacts_dir:
            artifact_dir = args.artifacts_dir
            if not artifact_dir.is_absolute():
                artifact_dir = ROOT / artifact_dir
            write_json(artifact_dir / "stow-semantic.json", baseline_semantic)
            write_json(artifact_dir / "chezmoi-semantic.json", chezmoi_semantic)
            write_json(artifact_dir / "stow-physical.json", baseline_physical)
            write_json(artifact_dir / "chezmoi-physical.json", chezmoi_physical)
            write_json(
                artifact_dir / "comparison.json",
                summary | {"unexplained_differences": unexplained_differences},
            )

        print(json.dumps(summary, indent=2, sort_keys=True))
        return 0 if not unexplained_differences else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"validation failed: {error}", file=sys.stderr)
        sys.exit(1)
