{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "opus",
  "permissions": {
    "deny": [
      "Bash(find / *)",
      "Bash(find ~ *)",
      "Bash(find ~/ *)",
      "Bash(find $HOME *)",
      "Bash(find /Users *)",
      "Bash(find ~/Downloads *)",
      "Bash(find ~/Desktop *)",
      "Bash(find ~/Documents *)",
      "Bash(find ~/Music *)",
      "Bash(find ~/Library *)",
      "Bash(mdfind *)",
      "Bash(locate *)"
    ]
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "theme": "auto",
  "autoCompactEnabled": true,
  "tui": "fullscreen"
}
