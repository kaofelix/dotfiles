{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "1.0.1",
  "hideThinkingBlock": false,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "editorPaddingX": 0,
  "showHardwareCursor": true,
  "tuiMode": "fullscreen",
  "packages": [
    {
      "source": {{ joinPath .chezmoi.workingTree "packages/pi-footer" | toJson }}
    },
    {
      "source": {{ joinPath .chezmoi.workingTree "packages/pi-tavily" | toJson }}
    },
    {
      "source": "git:github.com/steipete/agent-scripts",
      "skills": [
        "skills/swiftui-view-refactor",
        "skills/swiftui-performance-audit",
        "skills/swiftui-liquid-glass",
        "skills/swift-concurrency-expert",
        "skills/native-app-performance"
      ]
    },
    {
      "source": "git:github.com/anthropics/skills",
      "skills": [
        "skills/pdf"
      ]
    },
    {
      "source": "git:github.com/mattpocock/skills",
      "skills": [
        "skills/productivity/teach",
        "skills/productivity/writing-for-agents"
      ]
    },
    "npm:pi-watch",
    "npm:pi-autoresearch",
    "npm:pi-codex-goal",
    "npm:glimpseui",
    "npm:@crazygit/pi-codex-image-gen@0.2.2"
  ],
  "extensions": [
    "~/.pi/agent/npm/node_modules/glimpseui/examples/companion/index.ts"
  ],
  "skills": [
    "~/.agents/skills",
    "-skills/beads/SKILL.md",
    "-skills/ast-grep-skill/ast-grep/skills/ast-grep/SKILL.md"
  ],
  "prompts": [
    "-prompts/code-compare.md"
  ],
  "theme": "dark",
  "transport": "auto",
  "quietStartup": false
}
