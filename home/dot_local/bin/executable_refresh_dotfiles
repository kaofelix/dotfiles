#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: refresh_dotfiles [--sync]

Fast-forward the configured dotfiles checkout from its upstream branch, then
apply the latest chezmoi state to this machine. By default this changes files
only; local application dependencies may still need reconciliation.

The checkout must be clean. Commit or stash local source changes before running
this command. Neither mode requests software upgrades or removes unused tools.

Options:
  --sync     Run make sync after pulling: apply files, install declared tools
             and locked local dependencies, generate completions, and verify.
  -h, --help Show this help.
EOF
}

if (( $# > 1 )); then
    usage >&2
    exit 2
fi

sync=false
case "${1:-}" in
    "") ;;
    --sync) sync=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

if ! command -v chezmoi >/dev/null 2>&1; then
    printf 'error: chezmoi is required; run the dotfiles setup first\n' >&2
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    printf 'error: git is required\n' >&2
    exit 1
fi

if [[ "$sync" == true ]] && ! command -v make >/dev/null 2>&1; then
    printf 'error: make is required\n' >&2
    exit 1
fi

source_dir=$(chezmoi source-path)
repo_dir=$(git -C "$source_dir" rev-parse --show-toplevel)

if [[ -n $(git -C "$repo_dir" status --porcelain) ]]; then
    printf 'error: dotfiles checkout has local changes; commit or stash them first\n' >&2
    git -C "$repo_dir" status --short >&2
    exit 1
fi

git -C "$repo_dir" pull --ff-only
if [[ "$sync" == true ]]; then
    make -C "$repo_dir" sync
else
    chezmoi --source="$repo_dir" --destination="$HOME" apply
fi
