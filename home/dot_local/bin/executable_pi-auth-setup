#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: pi-auth-setup [--check]

Resolve 1Password-backed API-key entries from ~/.pi/agent/auth.op.json and
merge them into ~/.pi/agent/auth.json. Existing Pi-managed OAuth credentials
are preserved. The generated auth.json contains plaintext secrets and is
written with mode 0600.

Options:
  --check  Verify every configured 1Password reference without changing
           auth.json or printing secret values.
  -h, --help
           Show this help.
EOF
}

check=false
case "${1:-}" in
    "") ;;
    --check) check=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
source_file="$agent_dir/auth.op.json"
auth_file="$agent_dir/auth.json"

if [[ ! -f "$source_file" ]]; then
    echo "❌ Missing $source_file" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "❌ jq is required" >&2
    exit 1
fi

if ! command -v op >/dev/null 2>&1; then
    echo "❌ op is required" >&2
    exit 1
fi

jq_filter=$(cat <<'JQ'
type == "object" and all(.[];
    .type == "api_key" and
    (.key | test("^!op read 'op://[^']+'$"))
)
JQ
)
if ! jq -e "$jq_filter" "$source_file" >/dev/null; then
    echo "❌ $source_file must contain only command-backed API-key entries" >&2
    exit 1
fi

mkdir -p "$agent_dir"
umask 077
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/pi-auth.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
resolved_file="$tmp_dir/resolved.json"
next_file="$tmp_dir/next.json"
secret_file="$tmp_dir/secret"

jq '.' "$source_file" > "$resolved_file"

while IFS=$'\t' read -r provider command; do
    reference="${command#"!op read '"}"
    reference="${reference%"'"}"
    op read "$reference" > "$secret_file"

    if ! jq -e -n --rawfile secret "$secret_file" \
        '$secret | sub("[\\r\\n]+$"; "") | length > 0' >/dev/null; then
        echo "❌ 1Password returned an empty credential for $provider" >&2
        exit 1
    fi

    jq --arg provider "$provider" --rawfile secret "$secret_file" \
        '.[ $provider ].key = ($secret | sub("[\\r\\n]+$"; ""))' \
        "$resolved_file" > "$next_file"
    mv "$next_file" "$resolved_file"
done < <(jq -r 'to_entries[] | [.key, .value.key] | @tsv' "$source_file")

if [[ "$check" == true ]]; then
    echo "✅ Verified all configured 1Password references"
    exit 0
fi

output_file="$tmp_dir/auth.json"
if [[ -f "$auth_file" ]]; then
    jq -s '.[0] * .[1]' "$auth_file" "$resolved_file" > "$output_file"
else
    jq '.' "$resolved_file" > "$output_file"
fi

chmod 600 "$output_file"
mv "$output_file" "$auth_file"
trap - EXIT
rm -rf "$tmp_dir"

echo "✅ Generated $auth_file with resolved 1Password credentials"
